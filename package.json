{
    "name": "@miragon/modeler-i18n-workspace",
    "version": "0.0.0",
    "description": "Monorepo for the shared modeler translations library (@miragon/bpmn-modeler-i18n) and the Camunda Modeler i18n plugin.",
    "author": "Miragon GmbH <info@miragon.io>",
    "homepage": "https://github.com/Miragon/camunda-modeler-i18n-plugin",
    "bugs": {
        "url": "https://github.com/Miragon/camunda-modeler-i18n-plugin/issues"
    },
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "ssh://git@github.com/Miragon/camunda-modeler-i18n-plugin.git"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "npm run build -w packages/translations && npm run build -w apps/camunda-modeler-i18n-plugin",
        "build:lib": "npm run build -w packages/translations",
        "dev": "npm run dev -w apps/camunda-modeler-i18n-plugin",
        "pretest": "npm run build:lib",
        "test": "npm run test --workspaces --if-present",
        "test:watch": "npm run test:watch -w apps/camunda-modeler-i18n-plugin",
        "pretest:integration": "npm run build:lib",
        "test:integration": "npm run test:integration -w apps/camunda-modeler-i18n-plugin",
        "pretest:e2e": "npm run build",
        "test:e2e": "npm run test:e2e -w apps/camunda-modeler-i18n-plugin",
        "e2e:setup": "npm run e2e:setup -w apps/camunda-modeler-i18n-plugin",
        "harvest": "npm run harvest -w apps/camunda-modeler-i18n-plugin",
        "harvest:check": "npm run harvest:check -w apps/camunda-modeler-i18n-plugin",
        "check:translations": "npm run build:lib && npm run check:translations -w apps/camunda-modeler-i18n-plugin",
        "check:translations:baseline": "npm run build:lib && npm run check:translations:baseline -w apps/camunda-modeler-i18n-plugin",
        "check:translations:coverage": "npm run build:lib && npm run check:translations:coverage -w apps/camunda-modeler-i18n-plugin",
        "check:translations:seed": "npm run build:lib && npm run check:translations:seed -w apps/camunda-modeler-i18n-plugin",
        "sync:app-shell-keys": "npm run sync:app-shell-keys -w apps/camunda-modeler-i18n-plugin",
        "sync:modeler-deps": "npm run sync:modeler-deps -w apps/camunda-modeler-i18n-plugin",
        "sync:upstream-keys": "npm run sync:upstream-keys -w apps/camunda-modeler-i18n-plugin",
        "lint": "eslint .",
        "typecheck": "npm run typecheck -w packages/translations",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "knip": "knip",
        "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "dependency-cruiser": "18.2.0",
        "eslint": "10.9.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.11.0",
        "knip": "6.32.2",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    },
    "overrides": {
        "@bpmn-io/properties-panel": "3.48.0",
        "bpmn-js": "18.22.1",
        "bpmn-js-element-templates": "2.30.0",
        "bpmn-js-properties-panel": "5.62.0",
        "dmn-js": "17.10.1",
        "dmn-js-properties-panel": "3.11.1"
    }
}
